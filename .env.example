# Environment variables for AI Project
# Copy this file to .env and fill in your actual values

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangSmith Tracing (already configured in config.py)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=AI_Project
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Application Settings
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./ai_project.db

# Logging
LOG_LEVEL=INFO

# Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192

# Guardrails Configuration
GUARDRAILS_ENABLED=true
GUARDRAILS_MAX_LENGTH=5000
GUARDRAILS_MIN_LENGTH=1
GUARDRAILS_CONTENT_FILTER=true
GUARDRAILS_PII_DETECTION=true
GUARDRAILS_RATE_LIMITING=true
GUARDRAILS_RATE_LIMIT_REQUESTS=100
GUARDRAILS_RATE_LIMIT_WINDOW=60

# Security (for production)
# SECRET_KEY=your_secret_key_for_jwt_here
# ENVIRONMENT=production

# Caching (optional - for production)
# REDIS_URL=redis://localhost:6379

# Task Queue (optional - for async processing)
# CELERY_BROKER_URL=redis://localhost:6379/0

# Monitoring (optional)
# SENTRY_DSN=your_sentry_dsn_here

